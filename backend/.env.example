# Copier ce fichier en .env puis adapter les valeurs (NE JAMAIS committer le vrai .env)

# Connexion PostgreSQL : postgres:VOTRE_MOT_DE_PASSE@localhost:5432
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/b2b_orders?schema=public"

# Secret de signature des JWT : une longue chaîne aléatoire, jamais partagée
JWT_SECRET="changez-moi-par-une-longue-chaine-aleatoire"

# Durée de validité des tokens (ex. 12h, 1d)
JWT_EXPIRES_IN="1d"
